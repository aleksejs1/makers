# Copy to .env and adjust. All settings can also be passed as flags,
# see `makers serve -h`.

# Port the app listens on inside the container (point your reverse proxy here).
MAKERS_PORT=8080
# Public URL of the site (used for links, cookies, sitemap).
MAKERS_BASE_URL=https://makers.lv
# Secret for hashing login codes; at least 16 random characters.
# Generate one with: openssl rand -hex 32
MAKERS_SECRET=change-me
# Comma-separated emails of moderators.
MAKERS_ADMIN_EMAILS=
# IPs/CIDRs of reverse proxies allowed to set the client IP via X-Forwarded-For.
# With compose.yaml and a proxy on the host, requests arrive from the Docker network.
MAKERS_TRUSTED_PROXIES=172.16.0.0/12

# SMTP for login emails (required in production).
SMTP_HOST=
SMTP_PORT=587
# starttls (default), tls (implicit, default for port 465) or none (local mail catchers only)
SMTP_TLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=makers.lv <noreply@makers.lv>
